# Ambiente: development | staging | production
ENV=development

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=sua-loja.myshopify.com

# Desde 01/01/2026 apps personalizados legados (token "shpat_" fixo) nao podem
# mais ser criados. Apps do Dev Dashboard usam CLIENT CREDENTIALS: a aplicacao
# troca estas credenciais por um access token que expira em 24h e e renovado
# automaticamente.
#
# Requisitos: o app precisa estar INSTALADO na loja e pertencer a MESMA
# organizacao, senao a Shopify responde `shop_not_permitted`.
# Escopo necessario: read_orders.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Apenas para apps LEGADOS que ainda existem. Tem precedencia se preenchido.
SHOPIFY_ACCESS_TOKEN=
# Versao fixada explicitamente. Versoes expiram em ~1 ano; revisar a cada semestre.
SHOPIFY_API_VERSION=2026-07

# Afixos que fazem parte do `name` REAL do pedido na Shopify -- usados tambem
# para reconstruir o nome na busca.
#
# VERIFIQUE NA SUA LOJA antes de preencher. Na loja Grudado em Voce o `name` e
# "59552", SEM prefixo -- deixar "#" aqui faria a busca procurar "#59552", que
# nao existe, e TODA consulta voltaria "nao encontrado".
#
# O "#" que o cliente eventualmente digita e tolerado de qualquer forma na
# normalizacao: isto aqui e outra coisa, e so o afixo real do nome.
SHOPIFY_ORDER_PREFIX=
SHOPIFY_ORDER_SUFFIX=

# --- Frete Rapido ---
# A operacao usa 3 CNPJs e cada um tem seu proprio token: um token so enxerga os
# fretes do seu CNPJ. A TAG do pedido na Shopify diz qual empresa despachou, e e
# ela que escolhe o token.
#
# A CHAVE de cada entrada deve ser exatamente a tag usada no pedido (a
# comparacao ignora maiusculas e espacos nas bordas).
# Os tokens tem 32 caracteres e trafegam na query string: toda URL e redigida
# antes de qualquer log.
#
# Se a tag estiver ausente, desconhecida, ou o CNPJ indicado voltar vazio, a API
# consulta os demais em paralelo antes de concluir -- assim um pedido marcado
# com a tag errada nao vira "nao despachado".
FRETE_RAPIDO_TOKENS={"tag-empresa-1":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx","tag-empresa-2":"yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy","tag-empresa-3":"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"}

# Alternativa para operacao de CNPJ unico. Ignorado se FRETE_RAPIDO_TOKENS
# estiver preenchido.
FRETE_RAPIDO_TOKEN=

FRETE_RAPIDO_BASE_URL=https://freterapido.com
# Fuso ATRIBUIDO as datas naive da Frete Rapido (nao e conversao).
# PENDENTE de confirmacao com o fornecedor: horario de Brasilia ou UTC?
FRETE_RAPIDO_TIMEZONE=America/Sao_Paulo

# --- Webhook da Frete Rapido: aviso proativo por WhatsApp ---
#
# A FR faz POST numa URL nossa a cada atualizacao de ocorrencia. Cadastre a URL
# no Dash FR (nao ha API para isso) -- e confirme com o suporte deles se a
# configuracao e por CNPJ ou por conta, ja que a operacao usa 3 CNPJs.
#
#   https://SEU_DOMINIO/api/v1/webhook/frete-rapido/<FR_WEBHOOK_SEGREDO>
#
# ATENCAO: a Frete Rapido NAO assina o payload -- sem HMAC, sem cabecalho
# assinado, sem lista de IPs publicada. Este segredo e a unica barreira que
# impede qualquer um de postar ocorrencias falsas. Minimo de 32 caracteres,
# exigido no boot. Gere com:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# UM SEGREDO POR CNPJ. O cadastro no Dash FR e por CNPJ -- sao 3 cadastros, um
# por empresa (confirmado com o suporte em 03/08/2026).
#
# O payload NAO diz qual embarcador originou o evento (o unico CNPJ no corpo e o
# da transportadora), entao a identidade vem do segredo da URL: cada cadastro
# recebe uma URL distinta.
#
# O ganho principal e deteccao de falha, nao estatistica: com uma URL unica, um
# cadastro apagado ou com URL colada errada seria INDISTINGUIVEL de um CNPJ com
# pouco movimento. O relatorio 12 de deploy/monitor.sql mostra os 3 lado a lado.
#
# As chaves devem ser as MESMAS de FRETE_RAPIDO_TOKENS. Segredo repetido entre
# CNPJs derruba o boot -- a origem ficaria indeterminada.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # 1 por CNPJ
FR_WEBHOOK_SEGREDOS={"tag-empresa-1":"COLE_AQUI_1","tag-empresa-2":"COLE_AQUI_2","tag-empresa-3":"COLE_AQUI_3"}

# Alternativa para operacao de CNPJ unico, ou para quem nao precisa distinguir a
# origem. Ignorado se FR_WEBHOOK_SEGREDOS cobrir o cadastro.
#
# Vazio (e sem FR_WEBHOOK_SEGREDOS) DESLIGA a rota: ela responde 404 como
# qualquer caminho inexistente.
FR_WEBHOOK_SEGREDO=

# Segunda barreira, INDEPENDENTE da primeira. O painel da Frete Rapido tem campo
# proprio para Bearer token -- a documentacao publica nao menciona, mas o
# formulario de cadastro oferece Basic, Bearer e headers avulsos (verificado em
# 03/08/2026).
#
# E mecanismo melhor que o segredo do caminho: cabecalho nao aparece em log de
# acesso, nem em Referer, nem no historico de proxy. Usamos os dois.
#
# Vazio = so o segredo da URL e exigido. Preenchido = ambos precisam bater.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FR_WEBHOOK_BEARER=

# Interruptor geral do ENVIO.
#
# Com `false` (MODO OBSERVACAO) a API percorre o caminho inteiro -- recebe,
# filtra, classifica, deduplica e resolve o pedido na Shopify -- e grava o
# resultado SEM enviar nada. Nenhum cliente e contatado.
#
# Rode uma a duas semanas assim antes de ligar: os relatorios 9, 10 e 11 de
# `deploy/monitor.sql` respondem com dado real quais ocorrencias de fato
# acontecem, quantas mensagens sairiam por dia e quantos pedidos tem telefone.
NOTIFICACAO_ATIVA=false

# Grupos que disparam mensagem, separados por virgula. Um grupo inexistente
# DERRUBA O BOOT -- um erro de digitacao que virasse conjunto vazio desligaria
# os avisos em silencio, e ninguem descobre um aviso que nao foi enviado.
#
# Grupos validos: preparando, coletado, em_transito, saiu_para_entrega,
# entregue, aguardando_retirada, entrega_parcial, tentativa_falha, problema,
# devolucao, sinistro, cancelado, em_andamento
#
# Ponto de partida sugerido -- sao os dois grupos em que a encomenda VOLTA se o
# cliente nao agir:
#   aguardando_retirada,tentativa_falha
NOTIFICACAO_GRUPOS=

# Valvulas de escape por codigo de ocorrencia, para o caso pontual que o grupo
# nao resolve. Ordem de decisao: ignorados > extra > grupo.
#   NOTIFICACAO_CODIGOS_IGNORADOS=140  -> nunca avisa, mesmo dentro do grupo
#   NOTIFICACAO_CODIGOS_EXTRA=3        -> avisa mesmo fora dos grupos
# Catalogo: https://dev.freterapido.com.br/common/ocorrencias_da_fr/
#
# O 262 ("destinatario falecido") NAO precisa entrar aqui: ele foi movido para o
# grupo `problema` em services/ocorrencias.py, que nao dispara e nao exibe texto
# de orientacao na pagina. A correcao ficou na classificacao, que e onde ela
# vale para os dois canais de uma vez.
NOTIFICACAO_CODIGOS_EXTRA=
NOTIFICACAO_CODIGOS_IGNORADOS=

# Trava anti-spam, por PEDIDO. Uma transportadora que posta cinco codigos em
# sequencia nao pode virar cinco mensagens -- e um segredo vazado nao pode virar
# mil. Comece baixo nos primeiros dias com o envio ligado.
NOTIFICACAO_MAX_POR_PEDIDO=3
NOTIFICACAO_JANELA_HORAS=6

# Teto de TENTATIVAS por pedido na mesma janela. Limita CUSTO, nao mensagem: um
# evento que nunca confirma nao incrementa a cota de avisos e, sem este teto,
# cada repeticao custaria uma consulta a Frete Rapido -- na mesma cota de
# 720/min que a pagina de rastreio usa.
NOTIFICACAO_MAX_TENTATIVAS_PEDIDO=20

# Duracao do lease de processamento, em segundos. Enquanto vivo, so um processo
# cuida do evento -- e o que impede duas entregas simultaneas de virarem duas
# mensagens. Precisa cobrir o pior caso do caminho inteiro (Frete Rapido +
# Shopify + n8n) com folga.
NOTIFICACAO_LEASE_S=60

# Confirmar cada evento na PROPRIA Frete Rapido antes de avisar o cliente.
#
# O webhook nao e assinado: o segredo da URL prova que quem chamou o conhece,
# nao que o evento aconteceu. Antes de mandar mensagem, a API pergunta a fonte
# "este pedido tem mesmo esta ocorrencia?" -- um evento forjado nao sobrevive.
#
# Resolve o problema sem depender de IP fixo nem de nada que a Frete Rapido
# precise nos conceder, e ainda pega erro de operacao (URL trocada entre
# cadastros, numero de pedido errado no payload).
#
# Nao confirmado vira `pendente`, nao descarte: se o webhook chegar antes de a
# leitura refletir o evento, a escada de reentrega deles resolve sozinha.
#
# Deixe `true`. O `false` existe como interruptor de emergencia, caso as duas
# APIs deles algum dia divirjam e nada mais seja confirmado.
NOTIFICACAO_VERIFICAR_NA_FONTE=true

# --- n8n: quem de fato envia a mensagem ---
# A API decide, o n8n entrega. Deixe vazio na Fase 1.
#
# LEMBRE: este payload leva telefone e primeiro nome, e o n8n grava os dados de
# execucao no banco DELE -- fora do alcance de scripts/expurgar.py. Alinhe
# EXECUTIONS_DATA_MAX_AGE / o pruning do n8n com a retencao de 90 dias daqui.
N8N_WEBHOOK_URL=
# Enviado no cabecalho X-Webhook-Token. Sem ele, quem descobrir a URL do n8n
# dispara mensagem para qualquer telefone.
N8N_WEBHOOK_TOKEN=

# --- Banco ---
DATABASE_URL=postgresql+psycopg://rastreio:rastreio@localhost:5432/rastreio
# Chave do HMAC que pseudonimiza o email. Trocar invalida a correlacao historica.
EMAIL_HMAC_KEY=troque-esta-chave-por-um-valor-aleatorio-longo

# --- Deploy ---
# Dominio publico da API, usado pelo Caddy para emitir o certificado HTTPS.
#
# Sem acesso ao DNS do dominio principal, o sslip.io resolve qualquer IP sem
# cadastro: troque os pontos do IP do VPS por hifens.
#   IP 203.0.113.10  ->  API_DOMINIO=203-0-113-10.sslip.io
#
# Com dominio proprio, basta trocar por ele -- nenhum outro arquivo muda.
#   API_DOMINIO=api.sualoja.com.br
API_DOMINIO=

# Senha do PostgreSQL em producao (o compose de producao a exige).
# Gere com `openssl rand -hex 24` -- NAO use base64: a senha e interpolada na
# DATABASE_URL, e caracteres como / + @ quebram o parser da URL, produzindo um
# erro de conexao que nao aponta para a causa.
POSTGRES_PASSWORD=

# --- Seguranca ---
# Dominio da loja para CORS. Higiene de integracao, NAO barreira de seguranca:
# CORS restringe apenas navegadores.
CORS_ORIGINS=https://sua-loja.com.br
# IPs dos proxies confiaveis. Sem isto o rate limit enxerga 127.0.0.1 para todos
# e o controle e desligado silenciosamente.
TRUSTED_PROXIES=127.0.0.1
RATE_LIMIT=10/minute

# --- Modo demonstracao ---
# Falsifica Shopify E Frete Rapido juntas. A aplicacao se RECUSA a subir
# se isto for true com ENV=production.
DEMO_MODE=false
DEMO_EMAIL=demo@exemplo.com

# --- Testes de contrato (Camada 4) ---
# Pedido RECENTE: sem read_all_orders, some da API Shopify apos 60 dias.
CONTRACT_TEST_ORDER_NUMBER=
CONTRACT_TEST_EMAIL=
